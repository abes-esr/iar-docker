#
# Ci-dessous les variables pour configurer les conteneurs de ia rameau
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#

######################################################
# Caping for containers
######################################################
MEM_LIMIT=8g
CPU_LIMIT=8
# Accélération GPU pour les conteneurs Docker (true si GPU NVIDIA + drivers WSL configurés, sinon false)
ENABLE_GPU=false

######################################################
# Paramétrage version
######################################################
IAR_API_VERSION=test-api
IAR_VECTORISATION_VERSION=test-vectorisation
IAR_BATCH_DUMP_VERSION=test-batch-dump
IAR_QDRANT_VERSION=v1.19.1

######################################################
# Paramétrage de iar-batch-dump
######################################################
IAR_SPRING_PROFILES_ACTIVE=localhost

######################################################
# Paramétrage de iar-api
######################################################
IAR_API_HTTP_PORT=8071

######################################################
# Paramétrage de iar-qdrant
######################################################
IAR_QDRANT_HOST=iar-qdrant
IAR_QDRANT_PORT=6333
IAR_QDRANT_TEST_LIMIT=6
# Seuil minimal de vecteurs pour autoriser l'écrasement dans Qdrant (1000 en prod, baisser pour les petits CSV de test)
IAR_QDRANT_MIN_VECTORS=10

######################################################
# Paramétrage de iar-vectorisation
######################################################
IAR_VECTORISATION_HOST=0.0.0.0
IAR_VECTORISATION_PORT=8100
# IAR_CSV_INIT_FILENAME=
# IAR_CSV_UPDATE_FILENAME=
IAR_CSV_DIR=/app/data/csv
IAR_PKL_DIR=/app/data/pkl

IAR_DOCKER_NETWORK=iar-network
IAR_DOCKER_IMAGE_BATCH=abesesr/iar:${IAR_VECTORISATION_VERSION}
IAR_DOCKER_SOCK=unix:///var/run/docker.sock
IAR_DOCKER_BATCH_USER=root

IAR_VECTORIZE_CONCEPTS_OR_CHAINS=concepts
IAR_VECTORIZE_AVEC_THESE=only_mono


######################################################
# Paramétrage de iar-volume
######################################################
IAR_DATA_DIR=/app/data
IAR_DOCKER_VOLUME_BIND=./volumes




######################################################
# Paramétrage de iar-llm
######################################################
IAR_LLM_URL=https://llm.ilaas.fr/v1
IAR_LLM_KEY=votre_cle_api_llm
IAR_LLM_MODEL=llama-3.1-8b
